{
  "name": "@o-az/template-ts",
  "version": "1.3.0",
  "description": "A template for Node.js projects using ESM TypeScript",
  "keywords": [
    "cjs",
    "esm",
    "node.js",
    "pnpm",
    "template",
    "typescript",
    "vitest"
  ],
  "license": "GPT-v3-or-later",
  "author": "o-az (https://github.com/o-az)",
  "repository": "github:o-az/template-ts",
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --import='tsdown' --watch --env-file-if-exists='.env' ./src/index.ts",
    "start": "node --env-file-if-exists='.env' ./dist/index.mjs",
    "build": "tsdown --config='tsdown.config.ts'",
    "test": "vitest --run",
    "format": "oxfmt --config='oxfmt.config.ts' --write",
    "lint": "oxlint --config='oxlint.config.ts' --type-aware --type-check --fix-dangerously",
    "check": "bun format && bun lint",
    "check:types": "bun tsgo --project tsconfig.json --noEmit",
    "check-package": "pnpm dlx publint@latest --strict && pnpm exec attw --pack --ignore-rules cjs-resolves-to-esm",
    "release": "npm_config_yes='true' pnpm dlx bumpp package.json --commit --push --tag",
    "prerelease": "pnpm build && publint && attw --pack",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260428.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "publint": "^0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  }
}
